{
  "name": "unplatform-ai",
  "version": "0.5.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "deps:graph": "depcruise src --config .dependency-cruiser.cjs --output-type mermaid > docs/deps.mmd",
    "e2e": "node tests/e2e/run.mjs",
    "test": "vitest run",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "desktop:prepare": "node scripts/notices.mjs && next build && node scripts/prepare-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build && node scripts/compress-downloads.mjs && node scripts/size-report.mjs",
    "ffmpeg:build": "bash scripts/ffmpeg/build-unix.sh",
    "icon:mac": "node scripts/generate-mac-icon.mjs",
    "icons": "tauri icon app-icon.png && node scripts/generate-mac-icon.mjs && node scripts/generate-favicon.mjs && bash scripts/generate-header.sh",
    "node:build": "bash scripts/node/build-unix.sh",
    "notices": "node scripts/notices.mjs",
    "smoke": "node scripts/smoke-server.mjs",
    "tauri": "tauri",
    "size:report": "node scripts/size-report.mjs --check",
    "size:baseline": "node scripts/size-report.mjs --write-baseline",
    "check:standalone": "node scripts/check-standalone-compiled.mjs",
    "check:names": "node scripts/check-old-names.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/react": "^0.53.0",
    "@napi-rs/keyring": "^2.1.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "clsx": "^2.1.1",
    "lexical": "^0.53.0",
    "lexical-beautiful-mentions": "^0.1.48",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5.9",
    "typescript-eslint": "^8.72.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "ffmpeg-static"
    ]
  },
  "packageManager": "pnpm@12.14.0"
}
