{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/app/**/*.{ts,tsx}", "scripts/*.mjs", "tests/**/*.test.ts"],
  "project": ["src/**/*.{ts,tsx}", "src/**/*.css", "scripts/*.mjs", "tests/**/*.ts"],
  "ignoreBinaries": ["hdiutil", "rustc"],
  "ignoreDependencies": ["ffmpeg-static"],
  "ignoreIssues": {
    "src/core/providers/types.ts": ["duplicates"]
  }
}
